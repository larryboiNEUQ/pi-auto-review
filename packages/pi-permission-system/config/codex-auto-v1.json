{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "authorizerChain": ["safe-allow"],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.kube/config": "deny",
      "~/.config/gcloud/application_default_credentials.json": "deny",
      "~/.git-credentials": "deny",
      "~/.netrc": "deny",
      "~/.bash_profile": "deny",
      "~/.bashrc": "deny",
      "~/.profile": "deny",
      "~/.zprofile": "deny",
      "~/.zshenv": "deny",
      "~/.zshrc": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "cksum *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "date": "allow",
      "uptime": "allow",
      "which *": "allow",
      "type *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git branch": "allow",
      "git remote -v": "allow",
      "npm test *": "allow",
      "npm run test *": "allow",
      "npm run check *": "allow",
      "npm run typecheck *": "allow",
      "pnpm test *": "allow",
      "pnpm run test *": "allow",
      "pnpm run check *": "allow",
      "pnpm run typecheck *": "allow",
      "yarn test *": "allow",
      "yarn run test *": "allow",
      "yarn run check *": "allow",
      "yarn run typecheck *": "allow",
      "bun test *": "allow",
      "bun run test *": "allow",
      "bun run check *": "allow",
      "bun run typecheck *": "allow",
      "cargo test *": "allow",
      "go test *": "allow",
      "pytest *": "allow",
      "python -m pytest *": "allow",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "rm *": "ask"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": { "*": "allow" },
    "external_directory": {
      "*": "ask",
      "~/.ssh/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.kube/config": "deny",
      "~/.config/gcloud/application_default_credentials.json": "deny",
      "~/.git-credentials": "deny",
      "~/.netrc": "deny",
      "~/.bash_profile": "deny",
      "~/.bashrc": "deny",
      "~/.profile": "deny",
      "~/.zprofile": "deny",
      "~/.zshenv": "deny",
      "~/.zshrc": "deny"
    }
  }
}
